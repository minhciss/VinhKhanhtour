@model Poi
@{
    Layout = null;
    var list = ViewBag.Translations as List<PoiTranslation> ?? new();
    var cmsBase = ViewBag.CmsBaseUrl as string ?? "";
    var imgUrl = !string.IsNullOrEmpty(Model.ImageUrl)
        ? (Model.ImageUrl.StartsWith("http") ? Model.ImageUrl : $"{cmsBase}/images/{Model.ImageUrl}")
        : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0f172a">
    <title>@Model.Name – VinhKhanhTour</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            background: #0f172a;
            color: #e2e8f0;
            min-height: 100vh;
            padding-bottom: 40px;
        }

        /* ── HERO IMAGE ── */
        .hero {
            width: 100%;
            height: 280px;
            background: #1e293b;
            position: relative;
            overflow: hidden;
        }
        .hero img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .hero-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 5rem;
            color: rgba(255,255,255,0.1);
        }
        .hero-overlay {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            padding: 40px 20px 20px;
            background: linear-gradient(transparent, rgba(15,23,42,0.95));
        }
        .hero-overlay h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: white;
            margin-bottom: 4px;
        }
        .hero-overlay .address {
            font-size: 0.82rem;
            color: rgba(226,232,240,0.55);
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* ── BACK BUTTON ── */
        .back-btn {
            position: absolute;
            top: env(safe-area-inset-top, 16px);
            top: 16px;
            left: 16px;
            background: rgba(15,23,42,0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 50%;
            width: 40px; height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-decoration: none;
            font-size: 1.2rem;
            z-index: 10;
        }

        /* ── CONTENT ── */
        .content {
            padding: 20px 16px;
        }

        .description {
            font-size: 0.9rem;
            line-height: 1.7;
            color: rgba(226,232,240,0.65);
            margin-bottom: 24px;
        }

        /* ── AUDIO SECTION ── */
        .section-label {
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: rgba(226,232,240,0.35);
            margin-bottom: 12px;
        }

        .lang-tabs {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }
        .lang-tab {
            padding: 7px 14px;
            border-radius: 999px;
            font-size: 0.78rem;
            font-weight: 600;
            border: 1px solid rgba(255,255,255,0.12);
            background: rgba(255,255,255,0.05);
            color: rgba(226,232,240,0.6);
            cursor: pointer;
            transition: all .2s;
            -webkit-tap-highlight-color: transparent;
        }
        .lang-tab.active {
            background: linear-gradient(135deg, #38bdf8, #6366f1);
            border-color: transparent;
            color: white;
        }

        .audio-box {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.09);
            border-radius: 16px;
            padding: 16px;
        }
        .audio-title {
            font-size: 0.9rem;
            font-weight: 600;
            color: #f1f5f9;
            margin-bottom: 12px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        audio {
            width: 100%;
            border-radius: 10px;
            accent-color: #38bdf8;
        }

        .no-audio {
            text-align: center;
            padding: 30px;
            color: rgba(226,232,240,0.3);
            font-size: 0.9rem;
        }

        /* ── MAPS BUTTON ── */
        .maps-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 14px;
            padding: 14px;
            color: #38bdf8;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            margin-top: 20px;
            transition: background .2s;
            -webkit-tap-highlight-color: transparent;
        }
        .maps-btn:active { background: rgba(255,255,255,0.1); }

        /* ── DEVICE CHECK OVERLAY ── */
        #deviceCheckOverlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: #0f172a;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: white;
            transition: opacity 0.5s;
            text-align: center;
        }
        .loader {
            border: 4px solid rgba(255,255,255,0.1);
            border-top: 4px solid #38bdf8;
            border-radius: 50%;
            width: 40px; height: 40px;
            animation: spin 1s linear infinite;
            margin-bottom: 20px;
        }
        @@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body>

    <!-- DEVICE CHECK OVERLAY (DEMO) -->
    <div id="deviceCheckOverlay">
        <div class="loader" id="deviceCheckLoader"></div>
        <h3 id="deviceCheckText" style="font-weight: 600; font-size: 1.1rem; line-height: 1.5;">Đang kiểm tra cấu hình máy...</h3>
    </div>

    <!-- HERO -->
    <div class="hero">
        <a href="/tour" class="back-btn">‹</a>
        @if (!string.IsNullOrEmpty(imgUrl))
        {
            <img src="@imgUrl" alt="@Model.Name" />
        }
        else
        {
            <div class="hero-placeholder">🏛️</div>
        }
        <div class="hero-overlay">
            <h1>@Model.Name</h1>
            @if (!string.IsNullOrEmpty(Model.Address))
            {
                <p class="address">📍 @Model.Address</p>
            }
        </div>
    </div>

    <!-- CONTENT -->
    <div class="content">

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="description">@Model.Description</p>
        }

        <!-- AUDIO -->
        <p class="section-label">🎧 Thuyết minh</p>

        @if (list.Any())
        {
            <!-- LANG TABS -->
            <div class="lang-tabs" id="langTabs">
                @for (int i = 0; i < list.Count; i++)
                {
                    <button class="lang-tab @(i == 0 ? "active" : "")"
                            onclick="selectLang(@i)"
                            id="tab-@i">@list[i].LanguageCode.ToUpper()</button>
                }
            </div>

            <!-- AUDIO PLAYER -->
            <div class="audio-box" id="audioBox">
                <p class="audio-title" id="audioTitle">@list[0].Title</p>
                <audio id="audioPlayer" controls src="@list[0].AudioUrl">
                    Trình duyệt không hỗ trợ audio.
                </audio>
            </div>
        }
        else
        {
            <div class="no-audio">
                <p>🎙️</p>
                <p>Chưa có bản thuyết minh cho địa điểm này.</p>
            </div>
        }

        <!-- MAPS -->
        @if (!string.IsNullOrEmpty(Model.Address))
        {
            <a class="maps-btn"
               href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(Model.Address)"
               target="_blank">
                🗺️ Xem trên Google Maps
            </a>
        }
    </div>

    @if (list.Any())
    {
        var translationsJson = System.Text.Json.JsonSerializer.Serialize(
            list.Select(t => new { title = t.Title ?? "", audioUrl = t.AudioUrl ?? "" }).ToList()
        );
        <script>
            var translations = @Html.Raw(translationsJson);
            var listenLogged = false; // Chỉ log 1 lần mỗi lần vào trang

            function selectLang(index) {
                document.querySelectorAll('.lang-tab').forEach((tab, i) => {
                    tab.classList.toggle('active', i === index);
                });
                var t = translations[index];
                document.getElementById('audioTitle').textContent = t.title || '';
                var player = document.getElementById('audioPlayer');
                player.src = t.audioUrl;
                player.play().catch(() => {});
            }

            // Ghi nhận lượt nghe khi audio bắt đầu phát (lần đầu)
            document.getElementById('audioPlayer').addEventListener('play', function logListen() {
                if (listenLogged) return;
                listenLogged = true;

                var sessionKey = localStorage.getItem('vkt_session_key') || '';
                var cmsUrl = '@(ViewBag.CmsBaseUrl as string ?? "https://vinhkhanh-cms.onrender.com")';
                var poiId = @Model.Id;

                fetch(cmsUrl + '/api/unlock/mock-pay', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sessionKey: sessionKey, poiId: poiId, unlockType: 'auto' })
                }).catch(() => {}); // Im lặng — không ảnh hưởng UX
            });
        </script>
    }

    <script>
        // ── HEARTBEAT: báo cáo đang xem POI trên web ──
        (function() {
            var deviceId = localStorage.getItem('vkt_session_key');
            if (!deviceId) {
                deviceId = 'web-' + Math.random().toString(36).slice(2, 10);
                localStorage.setItem('vkt_session_key', deviceId);
            }
            var pingId = deviceId.startsWith('web-') ? deviceId : 'web-' + deviceId;
            var cmsUrl = '@(ViewBag.CmsBaseUrl as string ?? "https://vinhkhanh-cms.onrender.com")';

            // Biến global lưu config code demo (0: mạnh, 1: yếu)
            window.deviceConfigCode = 0; 

            function ping() {
                fetch(cmsUrl + '/api/sessions/ping', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ deviceId: pingId, configCode: window.deviceConfigCode })
                }).catch(() => {});
            }
            ping();
            setInterval(ping, 15000);
            document.addEventListener('visibilitychange', function() {
                if (!document.hidden) ping();
            });
        })();

        // ── DEVICE PERFORMANCE CHECK DEMO ──
        window.addEventListener('DOMContentLoaded', () => {
            const overlay = document.getElementById('deviceCheckOverlay');
            const text = document.getElementById('deviceCheckText');
            const loader = document.getElementById('deviceCheckLoader');
            
            // Giả lập delay 1.2s để tạo cảm giác quét
            setTimeout(() => {
                // Kiểm tra RAM (deviceMemory) và số nhân CPU (hardwareConcurrency)
                let ram = navigator.deviceMemory || 4; 
                let cores = navigator.hardwareConcurrency || 4;
                
                // Nếu CPU >= 4 nhân VÀ RAM >= 4GB thì coi là cấu hình mạnh
                let isStrong = (ram >= 4 && cores >= 4);
                let resultCode = isStrong ? 0 : 1;
                
                window.deviceConfigCode = resultCode; // Lưu lại để ping gửi lên Admin
                
                loader.style.display = 'none';
                if (resultCode === 0) {
                    text.innerHTML = "✅ Mã trả về: 0<br/><br/><span style='font-size:0.95rem;color:#4ade80;font-weight:400;'>Cấu hình mạnh</span>";
                } else {
                    text.innerHTML = "⚠️ Mã trả về: 1<br/><br/><span style='font-size:0.95rem;color:#f87171;font-weight:400;'>Cấu hình yếu</span>";
                }
                
                // Tự động tắt overlay sau 2.5 giây để vô app
                setTimeout(() => {
                    overlay.style.opacity = '0';
                    setTimeout(() => overlay.remove(), 500);
                }, 2500);
                
            }, 1200); 
        });
    </script>
</body>
</html>